pipeline{
    agent {
        node {
            label 'workstation'  # providing agent node name as workstation so in jenkins the job runs in workstation.
            }
           }
    stages {
        stage ('Docker Build') {
            steps {
            sh 'docker build -t thanukus3/r-frontend .'
            }
        }
       stage ('Docker Push') {
             steps {
                sh 'docker push thanukus3/r-frontend'
             }
        }
   }
  }