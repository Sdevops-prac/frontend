pipeline{
    agent {
        node {
            label 'Workstation'
            }
           }
    stages {

        stage('Debug') {
            steps {
                sh '''
                    echo "USER=$(whoami)"
                    id
                    groups
                    docker ps
                '''
            }
        }

        stage ('Docker Build') {
            steps {
            sh 'docker build -t thanukus3/r-frontend .'
            }
        }
       stage ('Docker Push') {
             steps {
                sh 'docker push thanukus3/r-frontend'
             }
        }
   }
  }